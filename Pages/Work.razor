@page "/work"

<PageTitle>Verified Work | CodeWithABKhan</PageTitle>

<section class="section-shell page-intro">
    <p class="section-kicker">Verified work index</p>
    <h1>Public repositories and proof links</h1>
    <p>
        This page lists the public artifacts currently safe to cite on the portfolio. If a claim cannot be traced to one of these
        public references, it should not appear as fact elsewhere on the site.
    </p>
</section>

<section class="section-shell">
    <div class="project-grid">
        @foreach (var project in Projects)
        {
            <article class="project-card">
                <div class="card-topline">
                    <span class="card-label">@project.Label</span>
                    <span class="card-date">@project.VerifiedDate</span>
                </div>
                <h2>@project.Title</h2>
                <p class="project-summary">@project.Summary</p>
                <p class="project-evidence">@project.Evidence</p>
                <ul class="tag-list">
                    @foreach (var tag in project.Tags)
                    {
                        <li>@tag</li>
                    }
                </ul>
                <div class="card-actions">
                    <a class="text-link" href="@project.RepoUrl" target="_blank" rel="noopener noreferrer">Repo</a>
                    @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
                    {
                        <a class="text-link" href="@project.LiveUrl" target="_blank" rel="noopener noreferrer">Live link</a>
                    }
                </div>
            </article>
        }
    </div>
</section>

@code {
    private static readonly IReadOnlyList<ProjectItem> Projects = new[]
    {
        new ProjectItem("Verified public repo", "2026-08-16 review", "codewithabkhan.github.io", "Public GitHub Pages portfolio rebuilt in Blazor WebAssembly to reflect only verified public evidence.", "Public repo exists on GitHub with `main` and `gh-pages` branches.", "https://github.com/CodeWithAbkhan/codewithabkhan.github.io", "https://codewithabkhan.github.io/", new[] { ".NET 8", "Blazor WebAssembly", "GitHub Pages" }),
        new ProjectItem("Verified live site + repo", "2026-05-15 live update", "sqlpey.com / sqlpeyNew", "A live technical publishing site with current public pages, matching attribution to abkhan, and a related public source repo updated in 2026.", "The live site returns 200 and the `sqlpeyNew` repo aligns with its current activity.", "https://github.com/CodeWithAbkhan/sqlpeyNew", "https://sqlpey.com/", new[] { "Publishing", "Blazor/.NET topics", "Live public site" }),
        new ProjectItem("Verified public repo", "2024-03-07 repo creation", "StaticBlazorBlog", "A public .NET 8 ASP.NET Core Blazor tutorial project with a linked YouTube walkthrough.", "Public README and pinned-profile references document the tutorial build.", "https://github.com/CodeWithAbkhan/StaticBlazorBlog", "https://youtu.be/B2TWGlE8noU", new[] { "Blazor", "Static rendering", "Tutorial project" }),
        new ProjectItem("Verified public repo", "2024-03-21 repo creation", "smpatients", "A documented patient-management project with public screenshots and repository evidence.", "The public README describes the stack, features, and deployment approach, but this site does not present it as a verified live production app.", "https://github.com/CodeWithAbkhan/smpatients", "", new[] { ".NET 8", "Blazor", "Healthcare software" }),
        new ProjectItem("Verified public repo", "2026-08-03 repo activity", "prism-skygarden-v4", "A recent Three.js reconstruction experiment described publicly as a stylized interpretation built with img2threejs.", "The public README explicitly labels it as interpretation rather than ground-truth geometry.", "https://github.com/CodeWithAbkhan/prism-skygarden-v4", "", new[] { "Three.js", "Experimental build", "Visual reconstruction" }),
        new ProjectItem("Verified public repo", "2026-08-03 repo activity", "prism-hq-v2", "An interactive procedural architectural scene with day, evening, and night modes described in the public README.", "Public repo and README provide the clearest proof for this creative-coding lane.", "https://github.com/CodeWithAbkhan/prism-hq-v2", "", new[] { "Three.js", "Procedural scene", "Interactive experiment" }),
