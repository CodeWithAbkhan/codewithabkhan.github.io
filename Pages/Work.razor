@page "/work"

<PageTitle>Selected Work | CodeWithABKhan</PageTitle>

<section class="subpage-hero section-frame">
    <div>
        <span class="section-number">WORK / PUBLIC INDEX</span>
        <h1>Built things.<br /><em>Visible proof.</em></h1>
    </div>
    <p class="subpage-intro">
        A focused index of public repositories and live artifacts across business software,
        AI-assisted development, publishing, and procedural 3D.
    </p>
</section>

<section class="page-section section-frame">
    <div class="work-index">
        @foreach (var project in Projects)
        {
            <article class="work-entry">
                <span class="work-entry-index">@project.Index</span>
                <div>
                    <span class="case-type">@project.Type</span>
                    <h2>@project.Title</h2>
                    <ul class="tag-list">
                        @foreach (var tag in project.Tags)
                        {
                            <li>@tag</li>
                        }
                    </ul>
                </div>
                <p>@project.Description</p>
                <div class="work-entry-links">
                    <a class="mini-link" href="@project.RepoUrl" target="_blank" rel="noopener noreferrer">Repository ↗</a>
                    @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
                    {
                        <a class="mini-link" href="@project.LiveUrl" target="_blank" rel="noopener noreferrer">Live / video ↗</a>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="closing-cta section-frame">
    <span class="section-number">YOUR PROJECT / NEXT</span>
    <h2>Need something this list does not cover?</h2>
    <p>The work can start from an existing system, a rough workflow, or a product idea that still needs a practical shape.</p>
    <div class="hero-actions">
        <a class="button button-inverse" href="mailto:awahab.akhan@gmail.com">Discuss the build ↗</a>
        <a class="button button-outline" href="/techs">See capabilities</a>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<ProjectItem> Projects = new[]
    {
        new ProjectItem("01", "Open-source product", "MauiPOS", "Cross-platform point-of-sale concept using .NET MAUI and Blazor Hybrid with one reusable interface across form factors.", "https://github.com/CodeWithAbkhan/MauiPOS", "", new[] { ".NET 9", "MAUI", "Blazor Hybrid" }),
        new ProjectItem("02", "Operational software", "SM Patients", "Patient-management system covering records, files, roles, reviews, and deployment through ASP.NET Core, SQL Server, and Docker.", "https://github.com/CodeWithAbkhan/smpatients", "", new[] { ".NET 8", "Healthcare", "Docker" }),
        new ProjectItem("03", "AI-assisted build", "QWEN Ecommerce", "Documented context-engineering experiment that produced a Blazor ecommerce application with authentication, Stripe, SQLite, and admin flows.", "https://github.com/CodeWithAbkhan/EbikeSore-QWEN", "https://youtu.be/g1IgxiKPgo8", new[] { "Blazor", "AI workflow", "Payments" }),
        new ProjectItem("04", "Procedural 3D", "Prism Skygarden", "Interactive floating conservatory reconstructed from concept art with Three.js, rendered day and night states, and a documented visual assessment.", "https://github.com/CodeWithAbkhan/prism-skygarden-v4", "", new[] { "Three.js", "img2threejs", "Visual systems" }),
        new ProjectItem("05", "Procedural 3D", "Prism HQ", "Interactive architectural scene with generated textures, furnished interiors, traffic, and day, evening, and night controls.", "https://github.com/CodeWithAbkhan/prism-hq-v2", "", new[] { "Three.js", "Creative code", "Interaction" }),
        new ProjectItem("06", "Business software", "HMS", "Public .NET 9 MAUI Blazor Hybrid repository exploring a desktop patient-management system.", "https://github.com/CodeWithAbkhan/HMS", "", new[] { ".NET 9", "MAUI", "Healthcare" }),
        new ProjectItem("07", "Technical publishing", "SQLPey", "Live technical publishing surface backed by public source work and a long-running focus on practical software notes.", "https://github.com/CodeWithAbkhan/sqlpeyNew", "https://sqlpey.com/", new[] { "Publishing", ".NET", "Public site" }),
        new ProjectItem("08", "Learning resource", "Static Blazor Blog", "Public .NET 8 static-rendering tutorial project paired with a video walkthrough.", "https://github.com/CodeWithAbkhan/StaticBlazorBlog", "https://youtu.be/B2TWGlE8noU", new[] { "Blazor", ".NET 8", "Tutorial" }),
    };

    private sealed record ProjectItem(string Index, string Type, string Title, string Description, string RepoUrl, string LiveUrl, IReadOnlyList<string> Tags);
}
