    private sealed record ProfileItem(string Label, string Title, string Description, string Url, string UrlText);
    private sealed record ProjectItem(string Label, string VerifiedDate, string Title, string Summary, string Evidence, string RepoUrl, string LiveUrl, IReadOnlyList<string> Tags);
