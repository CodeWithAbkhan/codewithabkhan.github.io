@page "/"

<PageTitle>CodeWithABKhan | Verified Portfolio</PageTitle>

<section class="hero-shell section-shell">
    <div class="eyebrow">Verified public portfolio - reviewed 2026-08-16</div>
    <div class="hero-grid">
        <div>
            <h1>AI agents and business software, built with a developer's eye for practical delivery.</h1>
            <p class="hero-copy">
                CodeWithABKhan is Abdul Wahab's public portfolio for software work that can be traced to live public profiles,
                repositories, and published artifacts. The strongest public proof today sits in .NET, Blazor, live technical publishing,
                and recent AI-assisted experiments.
            </p>
            <p class="hero-proof">
                Verified now: public GitHub work, a live X profile, a public Gumroad storefront, a live publishing site, and multiple
                repositories that show the shape of the work. Current direction: AI-assisted builds, agent-style workflows, and practical business software.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="/work">See the work</a>
                <a class="button button-secondary" href="https://github.com/CodeWithAbkhan" target="_blank" rel="noopener noreferrer">View GitHub projects</a>
            </div>
        </div>
        <aside class="signal-panel">
            <div class="signal-label">What is verified</div>
            <ul class="signal-list">
                @foreach (var signal in Signals)
                {
                    <li>
                        <span class="signal-title">@signal.Title</span>
                        <span class="signal-text">@signal.Detail</span>
                    </li>
                }
            </ul>
        </aside>
    </div>
</section>

<section class="section-shell" id="proof">
    <div class="section-header">
        <p class="section-kicker">Public proof</p>
        <h2>What can be checked right now</h2>
        <p>These links are live public references, not placeholders or private claims.</p>
    </div>
    <div class="profile-grid">
        @foreach (var profile in Profiles)
        {
            <article class="profile-card">
                <p class="card-label">@profile.Label</p>
                <h3>@profile.Title</h3>
                <p>@profile.Description</p>
                <a href="@profile.Url" target="_blank" rel="noopener noreferrer">@profile.UrlText</a>
            </article>
        }
    </div>
</section>

<section class="section-shell" id="work">
    <div class="section-header">
        <p class="section-kicker">Selected public work</p>
        <h2>Repositories with visible evidence</h2>
        <p>Each entry below is grounded in a public repository, live site, or public artifact that can be reviewed directly.</p>
    </div>
    <div class="project-grid">
        @foreach (var project in Projects.Take(4))
        {
            <article class="project-card">
                <div class="card-topline">
                    <span class="card-label">@project.Label</span>
                    <span class="card-date">@project.VerifiedDate</span>
                </div>
                <h3>@project.Title</h3>
                <p class="project-summary">@project.Summary</p>
                <p class="project-evidence">@project.Evidence</p>
                <ul class="tag-list">
                    @foreach (var tag in project.Tags)
                    {
                        <li>@tag</li>
                    }
                </ul>
                <div class="card-actions">
                    <a class="text-link" href="@project.RepoUrl" target="_blank" rel="noopener noreferrer">Repo</a>
                    @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
                    {
                        <a class="text-link" href="@project.LiveUrl" target="_blank" rel="noopener noreferrer">Live link</a>
                    }
                </div>
            </article>
        }
    </div>
    <div class="section-actions">
        <a class="button button-secondary" href="/work">See all verified entries</a>
    </div>
</section>

<section class="section-shell" id="services">
    <div class="section-header">
        <p class="section-kicker">Positioning</p>
        <h2>Services and build lanes</h2>
        <p>These are capability statements, not promises of outcomes that have not been publicly evidenced.</p>
    </div>
    <div class="service-grid">
        @foreach (var service in Services)
        {
            <article class="service-card">
                <p class="card-label">@service.Label</p>
                <h3>@service.Title</h3>
                <p>@service.Description</p>
            </article>
        }
    </div>
</section>

<section class="section-shell" id="direction">
    <div class="section-header">
        <p class="section-kicker">Current direction</p>
        <h2>Ideas and focus areas, clearly labeled</h2>
        <p>This section is intentionally separate from verified proof. It shows where the portfolio is heading next.</p>
    </div>
    <div class="direction-grid">
        @foreach (var item in Directions)
        {
            <article class="direction-card">
                <p class="card-label">Current focus</p>
                <h3>@item.Title</h3>
                <p>@item.Description</p>
            </article>
        }
    </div>
</section>

<section class="section-shell" id="contact">
    <div class="section-header">
        <p class="section-kicker">Contact</p>
        <h2>Start a build conversation</h2>
        <p>Best channels are the public profiles below or direct email. No auto-posting, no social automation, no fake inbox widget.</p>
    </div>
    <div class="contact-grid">
        <a class="contact-card" href="mailto:awahab.akhan@gmail.com">
            <span class="card-label">Email</span>
            <strong>awahab.akhan@gmail.com</strong>
            <span>Direct contact for serious project inquiries.</span>
        </a>
        <a class="contact-card" href="https://x.com/smile_Awahab" target="_blank" rel="noopener noreferrer">
            <span class="card-label">X</span>
            <strong>@@smile_Awahab</strong>
            <span>Public profile linked by the mission. Older public assets still show historical handle drift.</span>
        </a>
        <a class="contact-card" href="https://codewithabkhan.gumroad.com/" target="_blank" rel="noopener noreferrer">
            <span class="card-label">Gumroad</span>
            <strong>codewithabkhan.gumroad.com</strong>
            <span>Storefront is public; current public product count appears empty.</span>
        </a>
    </div>
</section>

