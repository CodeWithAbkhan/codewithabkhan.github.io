@page "/"

<PageTitle>CodeWithABKhan | AI Systems & Business Software</PageTitle>

<section class="hero section-frame">
    <div class="hero-copy">
        <div class="availability">
            <span class="availability-dot" aria-hidden="true"></span>
            Available for select builds
        </div>

        <h1>I turn AI into software people can <em>actually run.</em></h1>
        <p class="hero-intro">
            Independent full-stack builder creating AI agents, operational software, and practical
            .NET products—without the hype, black boxes, or endless prototype loop.
        </p>

        <div class="hero-actions">
            <a class="button button-primary" href="/work">Explore selected work <span aria-hidden="true">↗</span></a>
            <a class="button button-quiet" href="mailto:awahab.akhan@gmail.com">Tell me what you are building</a>
        </div>

        <ul class="proof-line" aria-label="Core capabilities">
            <li>.NET / Blazor</li>
            <li>AI agents</li>
            <li>Business systems</li>
            <li>Remote delivery</li>
        </ul>
    </div>

    <div class="hero-visual">
        <div class="visual-index">SYSTEM MAP / 01</div>
        <img src="images/ai-systems-workshop.webp"
             alt="Isometric AI system coordinating point of sale, healthcare, ecommerce, voice, and analytics modules"
             width="1536" height="1024" fetchpriority="high" />
        <div class="visual-caption">
            <span>One intelligent core</span>
            <span>Many useful surfaces</span>
        </div>
        <span class="orbit-label orbit-one">AGENTS</span>
        <span class="orbit-label orbit-two">OPS</span>
    </div>
</section>

<div class="ticker" aria-label="Build philosophy">
    <div class="ticker-track">
        <span>RESEARCH</span><i>✦</i><span>DESIGN</span><i>✦</i><span>BUILD</span><i>✦</i><span>INTEGRATE</span><i>✦</i><span>AUTOMATE</span><i>✦</i><span>SHIP</span>
    </div>
</div>

<section class="section-frame work-section" id="work">
    <div class="section-heading split-heading">
        <div>
            <span class="section-number">01 / SELECTED WORK</span>
            <h2>Proof, not promises.</h2>
        </div>
        <p>Public repositories and working artifacts across operational software, AI-assisted builds, and procedural 3D.</p>
    </div>

    <div class="featured-projects">
        <article class="case-card case-wide">
            <a class="case-media" href="https://github.com/CodeWithAbkhan/MauiPOS" target="_blank" rel="noopener noreferrer" aria-label="View MauiPOS on GitHub">
                <img src="images/case-studies/mauipos.webp" alt="MauiPOS interface shown across desktop, laptop, and mobile devices" width="1500" height="1000" loading="lazy" />
                <span class="case-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="case-copy">
                <div>
                    <span class="case-type">OPEN-SOURCE PRODUCT / .NET</span>
                    <h3>MauiPOS</h3>
                </div>
                <p>A cross-platform point-of-sale concept built with .NET MAUI and Blazor Hybrid from one reusable interface.</p>
                <ul class="tag-list"><li>.NET 9</li><li>MAUI</li><li>Blazor Hybrid</li></ul>
            </div>
        </article>

        <article class="case-card">
            <a class="case-media" href="https://github.com/CodeWithAbkhan/EbikeSore-QWEN" target="_blank" rel="noopener noreferrer" aria-label="View the QWEN ecommerce build on GitHub">
                <img src="images/case-studies/ebike-qwen.webp" alt="AI-assisted Blazor ecommerce store project presentation" width="1280" height="720" loading="lazy" />
                <span class="case-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="case-copy">
                <div>
                    <span class="case-type">AI-ASSISTED BUILD</span>
                    <h3>QWEN Ecommerce</h3>
                </div>
                <p>A full-stack Blazor experiment with authentication, payments, SQLite, and a documented context-engineering workflow.</p>
                <ul class="tag-list"><li>Blazor</li><li>Stripe</li><li>AI workflow</li></ul>
            </div>
        </article>

        <article class="case-card case-dark">
            <a class="case-media" href="https://github.com/CodeWithAbkhan/prism-skygarden-v4" target="_blank" rel="noopener noreferrer" aria-label="View Prism Skygarden on GitHub">
                <img src="images/case-studies/prism-skygarden-night.webp" alt="Procedural Three.js floating conservatory at night" width="1600" height="900" loading="lazy" />
                <span class="case-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="case-copy">
                <div>
                    <span class="case-type">PROCEDURAL 3D EXPERIMENT</span>
                    <h3>Prism Skygarden</h3>
                </div>
                <p>An interactive floating conservatory reconstructed from concept art with Three.js and an image-to-code workflow.</p>
                <ul class="tag-list"><li>Three.js</li><li>3D systems</li><li>img2threejs</li></ul>
            </div>
        </article>
    </div>

    <div class="section-end">
        <a class="text-link" href="/work">View the full work index <span aria-hidden="true">→</span></a>
    </div>
</section>

<section class="service-band" id="services">
    <div class="section-frame service-inner">
        <div class="section-heading service-heading">
            <span class="section-number">02 / WHAT I BUILD</span>
            <h2>AI where it creates leverage.<br /><em>Software where work gets done.</em></h2>
        </div>

        <div class="service-list">
            @foreach (var service in Services)
            {
                <article class="service-row">
                    <span class="service-index">@service.Index</span>
                    <div>
                        <h3>@service.Title</h3>
                        <p>@service.Description</p>
                    </div>
                    <div class="service-tags">
                        @foreach (var tag in service.Tags)
                        {
                            <span>@tag</span>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section-frame approach-section" id="approach">
    <div class="section-heading split-heading">
        <div>
            <span class="section-number">03 / HOW I WORK</span>
            <h2>From fuzzy idea to useful system.</h2>
        </div>
        <p>A visible, reviewable process designed to reduce wasted implementation and token burn.</p>
    </div>

    <ol class="process-grid">
        @foreach (var step in Process)
        {
            <li>
                <span class="process-number">@step.Index</span>
                <h3>@step.Title</h3>
                <p>@step.Description</p>
            </li>
        }
    </ol>
</section>

<section class="section-frame field-note">
    <div class="field-note-mark" aria-hidden="true">{ }</div>
    <div class="field-note-copy">
        <span class="section-number">BUILDER'S NOTE</span>
        <blockquote>“The best AI product is not the one with the most AI. It is the one that removes the most friction.”</blockquote>
        <p>That means clear interfaces, inspectable workflows, useful defaults, and a human in control when it matters.</p>
    </div>
    <div class="field-note-facts">
        <div><strong>19</strong><span>public repositories</span></div>
        <div><strong>2017</strong><span>building on GitHub since</span></div>
        <div><strong>Remote</strong><span>available worldwide</span></div>
    </div>
</section>

<section class="section-frame resource-section">
    <div>
        <span class="section-number">04 / OPEN RESOURCES</span>
        <h2>Useful code should create a head start.</h2>
        <p>Free software, build notes, and practical templates are the first step. Products and setup services come after the value is clear.</p>
    </div>
    <a class="resource-card" href="https://codewithabkhan.gumroad.com/" target="_blank" rel="noopener noreferrer">
        <span class="resource-kicker">CODEWITHABKHAN / GUMROAD</span>
        <strong>Free drops and practical software</strong>
        <span>Visit the storefront <b aria-hidden="true">↗</b></span>
    </a>
</section>

<section class="closing-cta section-frame">
    <span class="section-number">HAVE A REAL PROBLEM?</span>
    <h2>Let’s build the useful version.</h2>
    <p>Bring the workflow, bottleneck, or product idea. I’ll help turn it into a practical path to software.</p>
    <div class="hero-actions">
        <a class="button button-inverse" href="mailto:awahab.akhan@gmail.com">Start with an email <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="https://github.com/CodeWithAbkhan" target="_blank" rel="noopener noreferrer">Inspect the code</a>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<ServiceItem> Services = new[]
    {
        new ServiceItem("01", "AI agents & operator systems", "Chief-and-worker agent flows, research assistants, internal operators, and human-review checkpoints designed around a real job.", new[] { "Agent workflows", "Tool use", "Human review" }),
        new ServiceItem("02", "AI-powered business software", "POS, inventory, healthcare, school, and operations software where natural-language access improves an already useful system.", new[] { ".NET", "Blazor", "Databases" }),
        new ServiceItem("03", "Existing software, upgraded", "Add AI search, reporting, automation, voice, or assisted workflows to a product without rebuilding the entire foundation.", new[] { "Integration", "Modernization", "APIs" }),
        new ServiceItem("04", "Prototype to deployable product", "Move from an idea to a reviewable build with sensible architecture, polished interfaces, and deployment-ready project structure.", new[] { "Product UI", "Architecture", "Delivery" }),
    };

    private static readonly IReadOnlyList<ProcessItem> Process = new[]
    {
        new ProcessItem("01", "Frame the job", "Define the user, the decision, and what success looks like before choosing tools."),
        new ProcessItem("02", "Make it visible", "Turn the workflow into screens, states, and a small end-to-end system people can inspect."),
        new ProcessItem("03", "Add intelligence", "Use AI only where it improves speed, access, judgment, or automation without hiding control."),
        new ProcessItem("04", "Ship the evidence", "Test the real path, document the tradeoffs, and leave behind a maintainable product—not a demo trick."),
    };

    private sealed record ServiceItem(string Index, string Title, string Description, IReadOnlyList<string> Tags);
    private sealed record ProcessItem(string Index, string Title, string Description);
}
